# Free key from https://www.football-data.org/client/register
# Leave this file as-is (or omit .env entirely) and the app runs in demo mode
# against the bundled 30-season La Liga dataset.
FOOTBALL_API_KEY=your_key_here

# v2 Node service (npm start). Never commit a populated .env.
PORT=3000
HOST=127.0.0.1
DB_PATH=data/football.sqlite
# Set to 0 for read-only replicas; run only one ingestion worker per database.
SYNC_ENABLED=1

